  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model SubscriptionPlan {
  id                 String          @id @default(uuid())
  name               String
  maxUsers           Int             @default(5) @map("max_users")
  maxCompaniesPerUser Int            @default(3) @map("max_companies_per_user")
  features           String

  priceMonthly       Float           @default(0) @map("price_monthly")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  deletedAt          DateTime?       @map("deleted_at")
  companies          TenantCompany[]

  @@map("subscription_plans")
}

model TenantCompany {
  id                 String              @id @default(uuid())
  name               String
  legalName          String?             @map("legal_name")
  registrationNumber String?             @map("registration_number")
  taxId              String?             @map("tax_id")
  currencyCode       String              @default("USD") @map("currency_code")
  fiscalYearStart    String              @default("01-01") @map("fiscal_year_start")
  countryCode        String              @map("country_code")
  timezone           String
  logoUrl            String?             @map("logo_url")
  planId             String              @map("plan_id")
  status             String              @default("trial")

  trialEndsAt        DateTime?           @map("trial_ends_at")
  ownerId            String              @map("owner_id")
  legacyCompanyId    Int?                @unique @map("legacy_company_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  owner              TenantUser          @relation("tenant_company_owner", fields: [ownerId], references: [id])
  plan               SubscriptionPlan    @relation(fields: [planId], references: [id])
  memberships        UserCompanyMembership[]
  roles              RoleDefinition[]
  sessions           ActiveSession[]
