  clearedAt        DateTime       @default(now())
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([companyId, reconciliationId])
  @@index([companyId, transactionType, transactionId])
}

