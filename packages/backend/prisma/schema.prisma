generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums removed for SQLite compatibility


model Company {
  id Int @id @default(autoincrement())
  name                 String
  industry             String?
  legalName            String?
  gstin                String?
  pan                  String?
  email                String?
  phone                String?
  website              String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  pinCode              String?
  country              String?
  fiscalYearStartMonth Int?     @default(4)
  weightUnit           String?  @default("g")
  currency             String?  @default("INR")
  timezone             String?  @default("Asia/Kolkata")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
  branches   Branch[]
  users      User[]
  accountGroups AccountGroup[]
}

model Branch {
  id Int @id @default(autoincrement())
  companyId  Int
  name       String
  code       String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
  company    Company  @relation(fields: [companyId], references: [id])
}

model FinancialYear {
  id Int @id @default(autoincrement())
  companyId  Int
  label      String
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean   @default(true)
  isClosed   Boolean?  @default(false)
  closedAt   DateTime?
  closedBy   String?
  closingEntryId Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String
}

model User {
  id Int @id @default(autoincrement())
  companyId  Int
  email      String       @unique
  fullName   String
  password   String
  role       String
  status     String?      @default("ACTIVE")
  lastActiveOrgId Int?     @map("last_active_org_id")
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  createdBy  String
  company    Company      @relation(fields: [companyId], references: [id])
}

model Role {
  id Int @id @default(autoincrement())
  companyId  Int
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
}

model Permission {
  id Int @id @default(autoincrement())
  companyId  Int
  module     String
  action     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
}

model UserRole {
  id Int @id @default(autoincrement())
  companyId  Int
  userId     Int
  roleId     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
}

model AuditLog {
  id Int @id @default(autoincrement())
  companyId  Int
  userId     Int
  tableName  String
  recordId   Int
  action     String
  oldValues  String?
  newValues  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
}

model AuditEvent {
  id              String   @id
  occurredAt      DateTime @default(now())
  companyId       Int
  actorType       String   @default("USER") // USER | SYSTEM | API | SUPPORT
  actorId         String
  actorName       String
  actorRole       String?
  ipAddress       String?
  userAgent       String?
  sessionId       String?
  requestId       String?
  source          String   @default("UI") // UI | API | IMPORT | JOB | MIGRATION
  eventType       String   // e.g. "invoice.created", "invoice.updated", "invoice.voided", "auth.failed"
  entityType      String   // "Invoice", "Bill", "Expense", "Customer", "Account", "Setting", etc.
  entityId        String
  entityNumber    String?
  entityDate      DateTime?
  amountBefore    Float?
  amountAfter     Float?
  summary         String
  changesJson     String?
  revisionBefore  Int?
  revisionAfter   Int?
  reason          String?
  causedByEventId String?
  prevHash        String
  hash            String
  createdAt       DateTime @default(now())

  @@index([companyId, occurredAt])
  @@index([companyId, entityType, entityId, occurredAt])
  @@index([companyId, actorId, occurredAt])
  @@index([companyId, eventType, occurredAt])
}

model Notification {
  id Int @id @default(autoincrement())
  companyId  Int
  title      String
  body       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
}

model NumberSeries {
  id Int @id @default(autoincrement())
  companyId  Int
  docType    String
  prefix     String
  suffix     String?
  padding    Int      @default(4)
  current    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
}

model Setting {
  id Int @id @default(autoincrement())
  companyId  Int
  key        String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
}

model AccountGroup {
  id Int @id @default(autoincrement())
  companyId  Int
  heading    String   @default("EXPENSES")
  name       String
  code       String?
  type       String
  sortOrder  Int      @default(0)
  parentId   Int?
  parent     AccountGroup?  @relation("GroupToGroup", fields: [parentId], references: [id], onDelete: SetNull)
  children   AccountGroup[] @relation("GroupToGroup")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
  company    Company  @relation(fields: [companyId], references: [id])
  accounts   Account[]

  @@unique([companyId, name])
  @@index([companyId, type])
}

model Account {
  id Int @id @default(autoincrement())
  companyId       Int
  code            String
  name            String
  description     String?
  heading         String   @default("EXPENSES")
  group           String
  groupId         Int?
  type            String
  parentId        Int?
  openingBalance  Float
  taxCode         String?
  taxTreatment    String?
  showOnDashboard Boolean  @default(false)
  showInExpenseClaims Boolean @default(false)
  enablePayments  Boolean  @default(false)
  allowManualJournals Boolean @default(true)
  allowReconciliation Boolean @default(false)
  isBankAccount   Boolean  @default(false)
  isCashAccount   Boolean  @default(false)
  isControlAccount Boolean @default(false)
  cashFlowCategory String?
  financialCategory String?
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String
  accountGroup    AccountGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  bankAccounts    BankAccount[]

  @@unique([companyId, code])
  @@index([companyId, groupId])
}

model JournalEntry {
  id Int @id @default(autoincrement())
  companyId   Int
  entryNo     String
  date        DateTime
  narration   String
  type        String?
  status      String @default("DRAFT")
  postedAt    DateTime?
  postedBy    String?
  reversalOf  Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   String
  lines       JournalLine[]

  @@index([companyId, date, id])
  @@index([companyId, status, date])
  @@index([companyId, type])
}

model JournalLine {
  id Int @id @default(autoincrement())
  companyId    Int
  entryId      Int
  accountId    Int
  debit        Float
  credit       Float
  costCentreId Int?
  narration    String?
  reconciliationId Int?
  clearedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String
  entry        JournalEntry @relation(fields: [entryId], references: [id])

  @@index([companyId, accountId, createdAt])
  @@index([companyId, entryId])
  @@index([companyId, costCentreId])
}

model JournalTemplate {
  id Int @id @default(autoincrement())
  companyId   Int
  name        String
  narration   String?
  lines       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
}

model Customer {
  id Int @id @default(autoincrement())
  companyId   Int
  code        String
  name        String
  type        String?
  category    String?
  mobile      String?
  email       String?
  gstin       String?
  pan         String?
  openingBalance Float @default(0)
  creditLimit Float
  creditDays  Int      @default(0)
  city        String?
  notes       String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  invoices    Invoice[]
  payments    Payment[]
  schemeMembers SchemeMember[]
  noteDocuments NoteDocument[]

  @@unique([companyId, code])
}

model Invoice {
  id Int @id @default(autoincrement())
  companyId     Int
  invoiceNo     String
  date          DateTime
  dueDate       DateTime
  customerId    Int
  salespersonId Int?
  status        String @default("DRAFT")
  currency      String         @default("INR")
  goldRate22k   Float
  goldRate18k   Float
  goldRate24k   Float
  subTotal      Float
  discount      Float
  taxableAmount Float
  cgst          Float
  sgst          Float
  igst          Float
  grandTotal    Float
  paidAmount    Float
  balanceDue    Float
  notes         String?
  terms         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     String
  customer      Customer       @relation(fields: [customerId], references: [id])
  lines         InvoiceItem[]
  payments      Payment[]
  settlementsAsTarget DocumentSettlement[] @relation("SettlementTargetInvoice")
}

model InvoiceItem {
  id Int @id @default(autoincrement())
  companyId    Int
  invoiceId    Int
  itemId       Int?
  sku          String?
  description  String
  karat        String
  grossWt      Float
  netWt        Float
  stoneWt      Float
  makingType   String
  makingRate   Float
  makingAmount Float
  ratePerGram  Float
  amount       Float
  discountPct  Float
  gstPct       Float
  hsnCode      String
  huid         String?
  total        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item         Item?    @relation(fields: [itemId], references: [id])
}

model Payment {
  id Int @id @default(autoincrement())
  companyId  Int
  customerId Int?
  supplierId Int?
  invoiceId  Int?
  billId     Int?
  type       String
  date       DateTime
  mode       String
  amount     Float
  reference  String?
  receivedBy String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
  customer   Customer? @relation(fields: [customerId], references: [id])
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])
  bill       Bill?     @relation(fields: [billId], references: [id])
  settlementsAsSource DocumentSettlement[] @relation("SettlementSourcePayment")
}

model Supplier {
  id Int @id @default(autoincrement())
  companyId   Int
  code        String
  name        String
  category    String?
  mobile      String?
  email       String?
  gstin       String?
  city        String?
  openingBalance Float @default(0)
  creditLimit Float
  creditDays  Int      @default(0)
  notes       String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  bills       Bill[]
  payments    Payment[]
  noteDocuments NoteDocument[]

  @@unique([companyId, code])
}

model Bill {
  id Int @id @default(autoincrement())
  companyId     Int
  billNo        String
  date          DateTime
  dueDate       DateTime
  supplierId    Int
  status        String @default("DRAFT")
  qualityCertUrl String?
  subTotal      Float
  cgst          Float
  sgst          Float
  igst          Float
  paidAmount    Float @default(0)
  balanceDue    Float @default(0)
  discount      Float @default(0)
  taxableAmount Float @default(0)
  taxTotal      Float @default(0)
  grandTotal    Float
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     String
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  lines         BillItem[]
  payments      Payment[]
  settlementsAsTarget DocumentSettlement[] @relation("SettlementTargetBill")
}

model BillItem {
  id Int @id @default(autoincrement())
  companyId    Int
  billId       Int
  itemId       Int?
  sku          String
  description  String
  karat        String
  grossWt      Float
  netWt        Float
  stoneWt      Float
  makingType   String
  makingRate   Float
  makingAmount Float
  ratePerGram  Float
  amount       Float
  discountPct  Float
  gstPct       Float
  hsnCode      String
  total        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String
  bill         Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  item         Item?    @relation(fields: [itemId], references: [id])
}

model Item {
  id Int @id @default(autoincrement())
  companyId     Int
  sku           String
  name          String
  category      String
  subCategory   String?
  collection    String?
  metalType     String
  karat         String
  grossWt       Float
  netWt         Float
  stoneWt       Float
  wastagePct    Float
  costingMethod String
  makingType    String
  makingRate    Float
  costPrice     Float
  mrp           Float
  reorderLevel  Float
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String
  invoiceItems  InvoiceItem[]
  billItems     BillItem[]
  adjustmentLines InventoryAdjustmentLine[]
  codes         ItemCode[]

  @@unique([companyId, sku])
}

model ItemCode {
  id            Int       @id @default(autoincrement())
  companyId     Int
  itemId        Int
  code          String
  codeType      String    @default("INTERNAL_QR") // INTERNAL_QR, INTERNAL_128, EAN13, UPCA, EAN8, CODE128, GS1, MANUFACTURER, SUPPLIER, CUSTOM
  packQty       Float     @default(1)
  isPrimary     Boolean   @default(false)
  status        String    @default("ACTIVE") // ACTIVE, REVOKED
  revokedAt     DateTime?
  revokedBy     String?
  revokedReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String

  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId, itemId])
  @@index([companyId, status])
}

model LabelTemplate {
  id          Int       @id @default(autoincrement())
  companyId   Int
  name        String
  type        String    // THERMAL_ROLL, A4_SHEET
  widthMm     Float
  heightMm    Float
  columns     Int       @default(1)
  rows        Int       @default(1)
  marginMm    Float     @default(2)
  isDefault   Boolean   @default(false)
  layoutJson  String    // JSON config for fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
}

model LabelPrintJob {
  id          Int       @id @default(autoincrement())
  companyId   Int
  userId      String
  templateId  Int?
  totalLabels Int
  itemCount   Int
  status      String    @default("COMPLETED")
  detailsJson String    // Snapshot of items and quantities printed
  createdAt   DateTime  @default(now())

  @@index([companyId, createdAt])
}

model StockLedger {
  id Int @id @default(autoincrement())
  companyId       Int
  itemId          Int
  transactionType String
  referenceType   String
  referenceId     Int
  issuedQty       Float
  issuedWt        Float
  receivedQty     Float
  receivedWt      Float
  balanceQty      Float
  balanceWt       Float
  rate            Float
  value           Float
  narration       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String
}

model InventoryAdjustment {
  id Int @id @default(autoincrement())
  companyId        Int
  adjNo            String
  date             DateTime
  type             String
  reason           String
  status           String @default("DRAFT")
  approvedBy       String?
  supportingDocUrl String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdBy        String
  lines            InventoryAdjustmentLine[]
}

model InventoryAdjustmentLine {
  id Int @id @default(autoincrement())
  companyId     Int
  adjustmentId  Int
  itemId        Int
  currentQty    Float
  currentWt     Float
  adjustedQty   Float
  adjustedWt    Float
  diffQty       Float
  diffWt        Float
  oldRate       Float
  newRate       Float
  valueImpact   Float
  accountId     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String
  adjustment    InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item          Item @relation(fields: [itemId], references: [id])
}

model MetalRate {
  id Int @id @default(autoincrement())
  companyId      Int
  date           DateTime
  karat24        Float
  karat22        Float
  karat18        Float
  karat14        Float
  silver         Float
  source         String?
  overrideReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String
}

model Karigar {
  id Int @id @default(autoincrement())
  companyId      Int
  code           String
  name           String
  specialization String?
  mobile         String?
  gstin          String?
  pan            String?
  goldInHand     Float @default(0)
  makingDue      Float @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String
  jobWorkOrders  JobWorkOrder[]
}

model JobWorkOrder {
  id Int @id @default(autoincrement())
  companyId     Int
  jwoNo         String
  karigarId     Int
  karigar       Karigar  @relation(fields: [karigarId], references: [id])
  issueDate     DateTime
  expectedDate  DateTime?
  description   String?
  goldIssuedG   Float
  goldReturnedG Float
  allowedLossPct Float
  makingCharges Float
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String
}

model BankAccount {
  id Int @id @default(autoincrement())
  companyId      Int
  bankName       String
  accountName    String?
  accountNo      String?
  accountNoMasked String?
  ifsc           String
  accountType    String
  openingBalance Float @default(0)
  currentBalance Float @default(0)
  bookBalance    Float @default(0)
  bankBalance    Float @default(0)
  unreconciledCount Int    @default(0)
  isActive       Boolean  @default(true)
  accountId      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String
  account        Account? @relation(fields: [accountId], references: [id])
  transactions   BankTransaction[]
  importBatches  BankImportBatch[]
  feedLines      BankFeedLine[]
  reconciliations Reconciliation[]
}

model BankTransaction {
  id Int @id @default(autoincrement())
  companyId          Int
  bankAccountId      Int
  date               DateTime
  narration          String
  reference          String?
  debit              Float
  credit             Float
  balance            Float
  isReconciled       Boolean  @default(false)
  reconciledAt       DateTime?
  reconciliationId   Int?
  matchedJournalLineId Int?
  importBatchId      Int?
  source             String   @default("BANK_STATEMENT")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String
  bankAccount        BankAccount @relation(fields: [bankAccountId], references: [id])
}

model BankReconciliation {
  id Int @id @default(autoincrement())
  companyId            Int
  bankAccountId        Int
  month                Int
  year                 Int
  balancePerBank       Float
  depositsInTransit    Float
  outstandingCheques   Float
  adjustedBankBalance  Float
  balancePerBooks      Float
  difference           Float
  status               String
  finalizedAt          DateTime?
  finalizedBy          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdBy            String
}


model BankImportBatch {
  id              Int            @id @default(autoincrement())
  companyId       Int
  bankAccountId   Int
  fileName        String
  fileChecksum    String
  templateVersion String         @default("v1")
  totalRows       Int            @default(0)
  importedRows    Int            @default(0)
  duplicateRows   Int            @default(0)
  errorRows       Int            @default(0)
  openingBalance  Float?
  closingBalance  Float?
  status          String         @default("COMPLETED") // "COMPLETED" | "UNDONE"
  errorReportJson String?
  importedBy      String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  bankAccount     BankAccount    @relation(fields: [bankAccountId], references: [id])
  feedLines       BankFeedLine[]

  @@index([companyId, bankAccountId])
}

model BankFeedLine {
  id                    Int                 @id @default(autoincrement())
  companyId             Int
  bankAccountId         Int
  batchId               Int?
  txnDate               DateTime
  valueDate             DateTime?
  descriptionRaw        String
  descriptionNormalized String
  reference             String?
  payeeHint             String?
  debit                 Float               @default(0)
  credit                Float               @default(0)
  amount                Float               @default(0)
  runningBalance        Float?
  currency              String              @default("INR")
  dedupeHash            String
  status                String              @default("FOR_REVIEW") // "FOR_REVIEW" | "CATEGORIZED" | "MATCHED" | "TRANSFER" | "EXCLUDED"
  excludeReason         String?
  source                String              @default("TEMPLATE_IMPORT") // "TEMPLATE_IMPORT" | "MANUAL" | "API"
  ruleId                Int?
  ruleVersion           Int?
  ruleMode              String?             // "SUGGESTED" | "AUTO_ADDED"
  suggestedType         String?
  suggestedPayeeId      Int?
  suggestedAccountId    Int?
  suggestedTaxRate      Float?
  suggestedConfidence   Float?
  linkedTransactionId   Int?
  linkedTransactionType String?             // "JOURNAL" | "INVOICE_PAYMENT" | "BILL_PAYMENT" | "TRANSFER" | "EXPENSE"
  reviewedBy            String?
  reviewedAt            DateTime?
  rawRowJson            String?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  bankAccount           BankAccount         @relation(fields: [bankAccountId], references: [id])
  batch                 BankImportBatch?    @relation(fields: [batchId], references: [id])
  matches               BankFeedLineMatch[]
  ruleApplications      BankRuleApplication[]

  @@unique([companyId, bankAccountId, dedupeHash])
  @@index([companyId, bankAccountId, status, txnDate])
}

model BankFeedLineMatch {
  id              Int          @id @default(autoincrement())
  companyId       Int
  feedLineId      Int
  documentType    String       // "INVOICE" | "BILL" | "PAYMENT" | "JOURNAL" | "EXPENSE"
  documentId      Int
  allocatedAmount Float
  confidenceScore Float        @default(100)
  createdAt       DateTime     @default(now())
  feedLine        BankFeedLine @relation(fields: [feedLineId], references: [id], onDelete: Cascade)

  @@index([companyId, feedLineId])
  @@index([companyId, documentType, documentId])
}

model BankRule {
  id                   Int                    @id @default(autoincrement())
  companyId            Int
  name                 String
  groupId              Int?                   // Optional folder/group e.g. "Bank Charges", "Utilities"
  priority             Int                    @default(0) // Unique order per company (lower = evaluated first)
  applyToDirection     String                 @default("MONEY_OUT") // MONEY_IN | MONEY_OUT | BOTH
  matchMode            String                 @default("ALL") // ALL | ANY
  scopeAccountType     String                 @default("ALL") // ALL | SPECIFIC
  bankAccountId        Int?                   // Primary bankAccountId (legacy/single) or null for ALL
  bankAccountIdsJson   String                 @default("[]") // JSON array of BankAccount IDs when SPECIFIC

  // Safety & Auto-Add
  autoAdd              Boolean                @default(false)
  maxAutoAmount        Float?                 // Maximum amount ceiling for auto-add (safety guard)
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  isEnabled            Boolean                @default(true)
  status               String                 @default("ACTIVE") // ACTIVE | DISABLED | NEEDS_ATTENTION
  attentionReason      String?

  // Metrics
  version              Int                    @default(1)
  usageCount           Int                    @default(0)
  lastUsedAt           DateTime?
  overrideCount        Int                    @default(0)

  // Conditions & Actions
  conditionsJson       String                 // JSON array of RuleConditionDef
  actionType           String                 @default("CATEGORIZE") // CATEGORIZE | TRANSFER | EXCLUDE
  transactionType      String?                // EXPENSE | DEPOSIT | TRANSFER | CUSTOMER_PAYMENT | VENDOR_PAYMENT
  payeeExtractMode     String                 @default("NONE") // NONE | FIXED | EXTRACT_FROM_TEXT
  targetPayeeId        Int?
  targetPayeeName      String?
  targetAccountId      Int?
  targetTaxRate        Float?
  itcEligibility       String?                // ELIGIBLE | INELIGIBLE | BLOCKED_17_5
  isRcm                Boolean                @default(false)
  tdsSection           String?
  targetMemoTemplate   String?
  targetTagsJson       String?                @default("[]")
  excludeReason        String?
  transferAccountId    Int?                   // Destination BankAccount ID for transfers

  // Split Lines
  hasSplits            Boolean                @default(false)
  splitMode            String?                // PERCENTAGE | FIXED_AMOUNT
  splitsJson           String?                // JSON array of RuleSplitLineDef

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  createdBy            String?

  applications         BankRuleApplication[]
  versions             BankRuleVersion[]

  @@index([companyId, isEnabled, priority])
}

model BankRuleVersion {
  id         Int      @id @default(autoincrement())
  ruleId     Int
  version    Int
  ruleJson   String   // Complete snapshot of the rule definition at this version
  createdAt  DateTime @default(now())
  createdBy  String?

  rule       BankRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
  @@index([ruleId])
}

model BankRuleApplication {
  id                    Int          @id @default(autoincrement())
  companyId             Int
  ruleId                Int
  ruleVersion           Int
  feedLineId            Int
  mode                  String       // SUGGESTED | AUTO_ADDED
  resultTransactionId   Int?
  resultTransactionType String?
  isUndone              Boolean      @default(false)
  undoneAt              DateTime?
  undoneBy              String?
  isOverridden          Boolean      @default(false)
  appliedAt             DateTime     @default(now())

  rule                  BankRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  feedLine              BankFeedLine @relation(fields: [feedLineId], references: [id], onDelete: Cascade)

  @@index([companyId, ruleId, appliedAt])
  @@index([feedLineId])
}

model Reconciliation {
