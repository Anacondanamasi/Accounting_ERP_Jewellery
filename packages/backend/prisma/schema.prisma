  @@index([planId])
  @@index([status])
  @@map("companies")
}

model UserCompanyMembership {
  id                  String            @id @default(uuid())
  userId              String            @map("user_id")
  companyId           String            @map("company_id")
  roleId              String            @map("role_id")
  invitedBy           String?           @map("invited_by")
  invitationToken     String?           @map("invitation_token")
  invitationExpiresAt DateTime?         @map("invitation_expires_at")
  status              String            @default("pending")

  joinedAt            DateTime?         @map("joined_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  deletedAt           DateTime?         @map("deleted_at")
  user                TenantUser        @relation(fields: [userId], references: [id])
  company             TenantCompany     @relation(fields: [companyId], references: [id])
  role                RoleDefinition    @relation(fields: [roleId], references: [id])
  inviter             TenantUser?       @relation("membership_invited_by", fields: [invitedBy], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([status])
  @@index([invitationToken])
  @@map("user_company_memberships")
}

model RoleDefinition {
  id            String                  @id @default(uuid())
  companyId     String?                 @map("company_id")
  name          String
  isSystemRole  Boolean                 @default(false) @map("is_system_role")
  description   String
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  deletedAt     DateTime?               @map("deleted_at")
  company       TenantCompany?          @relation(fields: [companyId], references: [id])
  memberships   UserCompanyMembership[]
  permissions   RolePermission[]

  @@unique([companyId, name])
  @@index([isSystemRole])
  @@map("roles")
}

model PermissionDefinition {
  id          String           @id @default(uuid())
  code        String           @unique
  module      String
  description String
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String               @map("role_id")
  permissionId String               @map("permission_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  role         RoleDefinition       @relation(fields: [roleId], references: [id])
  permission   PermissionDefinition @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ActiveSession {
